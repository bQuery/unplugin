{
  "name": "@bquery/unplugin",
  "version": "0.1.0",
  "description": "Official bundler plugin for bQuery (Vite, Rollup, webpack, Rspack, esbuild): view precompilation with HMR, i18n catalog extraction, file-route manifests, CSP nonces and an SSR dev middleware.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./rollup": {
      "types": "./rollup.d.ts",
      "default": "./rollup.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    },
    "./rspack": {
      "types": "./rspack.d.ts",
      "default": "./rspack.js"
    },
    "./esbuild": {
      "types": "./esbuild.d.ts",
      "default": "./esbuild.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "vite.js",
    "vite.d.ts",
    "rollup.js",
    "rollup.d.ts",
    "webpack.js",
    "webpack.d.ts",
    "rspack.js",
    "rspack.d.ts",
    "esbuild.js",
    "esbuild.d.ts",
    "client.d.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "keywords": [
    "bquery",
    "unplugin",
    "vite-plugin",
    "rollup-plugin",
    "webpack-plugin",
    "rspack-plugin",
    "esbuild-plugin",
    "i18n",
    "file-routing",
    "ssr",
    "csp"
  ],
  "author": "Jonas Pfalzgraf <support@josunlp.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bQuery/unplugin.git"
  },
  "homepage": "https://github.com/bQuery/unplugin#readme",
  "bugs": {
    "url": "https://github.com/bQuery/unplugin/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "unplugin": "^3.4.0"
  },
  "peerDependencies": {
    "@bquery/bquery": "^1.18.0",
    "@rspack/core": ">=1.0.0",
    "esbuild": ">=0.18.0",
    "rollup": ">=3.0.0",
    "vite": ">=5.1.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bquery/bquery": "^1.18.0",
    "@types/bun": "^1.4.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
